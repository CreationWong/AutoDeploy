# Only runtime inputs belong in the build context (never local secrets or tools).
**
!Dockerfile
!.dockerignore
!entrypoint.sh
!scripts/
scripts/**
!scripts/autodeploy
!scripts/autodeploy-deploy
!scripts/autodeploy-endpoints
!scripts/autodeploy-runtime
!scripts/post-receive
!conf/
conf/**
!conf/nginx-autodeploy.conf
!conf/supervisord.conf
!conf/sshd_config
!conf/autodeploy.sudoers
