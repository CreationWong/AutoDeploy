set -euo pipefail

DATA_DIR="${AUTODEPLOY_DATA_DIR:-/data}"
ENV_FILE="/etc/autodeploy/env"
SETTINGS_FILE="$DATA_DIR/settings.env"
GIT_HOME="$DATA_DIR/git-home"

log() { printf '[AutoDeploy] %s\n' "$*"; }
# shellcheck source=src/scripts/autodeploy-endpoints
. /usr/local/bin/autodeploy-endpoints
# shellcheck source=src/scripts/autodeploy-runtime
. /usr/local/bin/autodeploy-runtime

load_settings() {
  if [ -r "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
  fi
  if [ -r "$SETTINGS_FILE" ]; then
    set -a
    . "$SETTINGS_FILE"
    set +a
  fi
  [ -z "${requested_language:-}" ] || AUTODEPLOY_LANG="$requested_language"
  REPO_NAME="${REPO_NAME:-app}"
  DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"
  DEPLOY_TAG="${DEPLOY_TAG:-}"
  DEPLOY_TAG_MODE="${DEPLOY_TAG_MODE:-commit}"
  AUTODEPLOY_CONFIG_NAME="${AUTODEPLOY_CONFIG_NAME:-AutoDeploy.config.yaml}"
  autodeploy_validate_settings "$REPO_NAME" "$AUTODEPLOY_CONFIG_NAME" "$DEPLOY_TAG_MODE"
}

write_env_file() {
  local tmp
  tmp="$(mktemp)"
  {
    printf 'REPO_NAME=%q\n' "$REPO_NAME"
    printf 'DEPLOY_BRANCH=%q\n' "$DEPLOY_BRANCH"
    printf 'DEPLOY_TAG=%q\n' "$DEPLOY_TAG"
    printf 'DEPLOY_TAG_MODE=%q\n' "$DEPLOY_TAG_MODE"
    printf 'AUTODEPLOY_CONFIG_NAME=%q\n' "$AUTODEPLOY_CONFIG_NAME"
    printf 'AUTODEPLOY_LANG=%q\n' "${AUTODEPLOY_LANG:-en}"
    printf 'AUTODEPLOY_APP_USER=%q\n' "${AUTODEPLOY_APP_USER:-autodeploy-app}"
  } > "$tmp"
  chown root:git "$tmp" 2>/dev/null || true
  chmod 640 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

cmd_show() {
  load_settings
  echo "$(autodeploy_text 'AutoDeploy settings')"
  printf '  AUTODEPLOY_LANG        = %s\n' "${AUTODEPLOY_LANG:-en}"
  printf '  REPO_NAME              = %s\n' "$REPO_NAME"
  printf '  DEPLOY_BRANCH          = %s\n' "$DEPLOY_BRANCH"
  printf '  DEPLOY_TAG             = %s\n' "${DEPLOY_TAG:-<$(autodeploy_text disabled)>}"
  printf '  DEPLOY_TAG_MODE        = %s\n' "$DEPLOY_TAG_MODE"
  printf '  AUTODEPLOY_CONFIG_NAME = %s\n' "$AUTODEPLOY_CONFIG_NAME"
  printf '  HTTP_USER              = %s\n' "$(autodeploy_http_user)"
  autodeploy_log_endpoints
  echo

  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  echo "$(autodeploy_msg 'Bare repository: %s' "$repo_dir")"
  if [ -d "$repo_dir" ] && git --git-dir="$repo_dir" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    git --git-dir="$repo_dir" log -1 --date=short \
      --format="$(autodeploy_text '  Latest commit: %h %s (%an, %ad)')"
  else
    echo "$(autodeploy_text '  (No commits yet)')"
  fi
  echo

  echo "$(autodeploy_text 'Deployment status:')"
  local f found=0 n t s c b u fc d
  for f in "$DATA_DIR"/state/*/deploy.json; do
    [ -f "$f" ] || continue
    found=1
    n="$(yq -r '.name // ""' "$f")"
    t="$(yq -r '.type // ""' "$f")"
    s="$(yq -r '.status // ""' "$f")"
    c="$(yq -r '.commit // ""' "$f")"
    b="$(yq -r '.branch // ""' "$f")"
    u="$(yq -r '.updated_at // ""' "$f")"
    fc="$(yq -r '.failed_commit // ""' "$f")"
    printf '  %s (type=%s) status=%s branch=%s commit=%.12s at %s\n' "$n" "$t" "$s" "$b" "$c" "$u"
    [ -n "$fc" ] && printf "$(autodeploy_text '    Failed commit: %.12s\n')" "$fc"
    d="$DATA_DIR/state/$n/failed.json"
    if [ -f "$d" ]; then
      printf "$(autodeploy_text '    Marked as failed: %.12s (%s, rescued=%s) %s\n')" \
        "$(yq -r '.commit // ""' "$d")" "$(yq -r '.branch // ""' "$d")" \
        "$(yq -r '.rescued // false' "$d")" "$(yq -r '.message // ""' "$d")"
    fi
  done
  [ "$found" = "1" ] || echo "$(autodeploy_text '  (No deployment records)')"
}

cmd_log() {
  load_settings
  local n="${1:-10}"
  case "$n" in ''|*[!0-9]*) n=10 ;; esac
  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  if [ ! -d "$repo_dir" ]; then
    echo "$(autodeploy_msg 'Bare repository does not exist: %s' "$repo_dir")" >&2
    return 1
  fi
  if ! git --git-dir="$repo_dir" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    echo "$(autodeploy_text '(No commit history)')"
    return 0
  fi
  git --git-dir="$repo_dir" log -n "$n" --all --decorate --date=short \
    --format='%h  %ad  %an  %d %s'
}

cmd_set() {
  load_settings
  local key="$1" value="$2" tmp
  key="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
  case "$key" in
    CONFIG_NAME|AUTODEPLOY_CONFIG_NAME) key=AUTODEPLOY_CONFIG_NAME ;;
    REPO_NAME|DEPLOY_BRANCH|DEPLOY_TAG|DEPLOY_TAG_MODE|AUTODEPLOY_LANG) ;;
    *)
      echo "$(autodeploy_msg 'Unknown setting: %s. Run autodeploy help' "$1")" >&2
      return 1
      ;;
  esac
  if [ -z "$value" ] && [ "$key" != "DEPLOY_TAG" ]; then
    echo "$(autodeploy_text 'Value must not be empty')" >&2
    return 1
  fi

  case "$key" in
    AUTODEPLOY_LANG)
      case "$value" in en|zh) ;; *) echo "$(autodeploy_text 'AUTODEPLOY_LANG must be en or zh')" >&2; return 1 ;; esac
      ;;
    REPO_NAME)
      autodeploy_validate_settings "$value" "$AUTODEPLOY_CONFIG_NAME" "$DEPLOY_TAG_MODE" || return 1
      ;;
    AUTODEPLOY_CONFIG_NAME)
      autodeploy_validate_settings "$REPO_NAME" "$value" "$DEPLOY_TAG_MODE" || return 1
      ;;
    DEPLOY_TAG_MODE)
      autodeploy_validate_settings "$REPO_NAME" "$AUTODEPLOY_CONFIG_NAME" "$value" || return 1
      ;;
  esac

  tmp="$(mktemp)"
  if [ -f "$SETTINGS_FILE" ]; then
    grep -v "^${key}=" "$SETTINGS_FILE" > "$tmp" || true
  fi
  printf '%s=%q\n' "$key" "$value" >> "$tmp"
  chown root:git "$tmp"
  chmod 640 "$tmp"
  mv "$tmp" "$SETTINGS_FILE"

  case "$key" in
    AUTODEPLOY_LANG) AUTODEPLOY_LANG="$value" ;;
    REPO_NAME) REPO_NAME="$value" ;;
    DEPLOY_BRANCH) DEPLOY_BRANCH="$value" ;;
    DEPLOY_TAG) DEPLOY_TAG="$value" ;;
    DEPLOY_TAG_MODE) DEPLOY_TAG_MODE="$value" ;;
    AUTODEPLOY_CONFIG_NAME) AUTODEPLOY_CONFIG_NAME="$value" ;;
  esac
  write_env_file
  log "$(autodeploy_msg 'Saved %s=%s (deployment rules apply on next push)' "$key" "$value")"
}

cmd_deploy() {
  load_settings
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo "$(autodeploy_text 'Usage: autodeploy deploy <branch|tag|commit>')" >&2
    return 1
  fi
  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  if [ ! -d "$repo_dir" ]; then
    echo "$(autodeploy_msg 'Bare repository does not exist: %s' "$repo_dir")" >&2
    return 1
  fi
  GIT_DIR="$repo_dir" /usr/local/bin/autodeploy-post-receive --ref "$ref"
}

cmd_logs() {
  load_settings
  local name="${1:-}" n="${2:-50}" f
  case "$n" in ''|*[!0-9]*) n=50 ;; esac
  if [ -z "$name" ]; then
    for f in "$DATA_DIR"/state/*/deploy.json; do
      [ -f "$f" ] || continue
      name="$(yq -r '.name // ""' "$f" 2>/dev/null || true)"
      [ -n "$name" ] && break
    done
  fi
  if [ -z "$name" ]; then
    echo "$(autodeploy_text 'Application not found; usage: autodeploy logs <name> [N]')" >&2
    return 1
  fi
  local dir="$DATA_DIR/logs/$name"
  if [ ! -d "$dir" ]; then
    echo "$(autodeploy_msg 'Log directory does not exist: %s' "$dir")" >&2
    return 1
  fi
  for f in "$dir"/*.log; do
    [ -f "$f" ] || continue
    echo "$(autodeploy_msg '==> %s (last %s lines) <==' "$f" "$n")"
    tail -n "$n" "$f"
  done
}

cmd_retry() {
  load_settings
  local commit="" f
  for f in "$DATA_DIR"/state/*/last-success.json "$DATA_DIR"/state/*/deploy.json; do
    [ -f "$f" ] || continue
    if [ "$(yq -r '.status // ""' "$f" 2>/dev/null || true)" = "success" ]; then
      commit="$(yq -r '.commit // ""' "$f" 2>/dev/null || true)"
      [ -n "$commit" ] && break
    fi
  done
  if [ -z "$commit" ]; then
    echo "$(autodeploy_text 'No successful commit available to retry')" >&2
    return 1
  fi
  echo "$(autodeploy_msg 'Redeploying last successful commit: %s' "${commit:0:12}")"
  cmd_deploy "$commit"
}

cmd_help() {
  printf '%s\n' "$(autodeploy_text 'AutoDeploy management commands

Usage: autodeploy <command> [arguments]

  show                      Show settings, latest commit and status
  set <KEY> <VALUE>         Save a setting (survives restarts)
  deploy <branch|tag|commit> Deploy a branch, tag or commit
  retry                     Redeploy the last successful commit
  logs [name] [N]           Show logs (default: first app, 50 lines)
  log [N]                   Show commit history (last 10 commits)
  license                   Show the GNU GPL version 3 license
  help                      Show this help

Available settings:
  REPO_NAME                 Repository/default app name (default: app)
  DEPLOY_BRANCH             Comma-separated branch patterns (default main)
  DEPLOY_TAG                Comma-separated tag patterns (empty disables tags)
  DEPLOY_TAG_MODE           commit=tagged commit / branch=latest branch commit
  AUTODEPLOY_CONFIG_NAME    Configuration filename (default AutoDeploy.config.yaml)
  AUTODEPLOY_LANG           Output language: en (default) or zh

Project deploy rules override these defaults.
Deployment rules apply on next push. REPO_NAME does not rename existing repositories.

Copyright (C) 2026 CreationWong
License: GNU GPL version 3 (GPL-3.0-only). This program comes with no warranty.
Modification and redistribution are permitted under the license; run autodeploy license.')"
}

requested_language="${AUTODEPLOY_LANG-}"
load_settings
[ -z "$requested_language" ] || AUTODEPLOY_LANG="$requested_language"

case "${1:-help}" in
  show|status) cmd_show ;;
  license|--license) cat /usr/share/doc/autodeploy/LICENSE ;;
  log|history)
    shift
    cmd_log "${1:-10}"
    ;;
  set)
    shift
    if [ "$#" -lt 2 ]; then
      echo "$(autodeploy_text 'Usage: autodeploy set <KEY> <VALUE>')" >&2
      exit 1
    fi
    cmd_set "$1" "$2"
    ;;
  deploy)
    shift
    cmd_deploy "${1:-}"
    ;;
  retry|redeploy) cmd_retry ;;
  logs)
    shift
    cmd_logs "${1:-}" "${2:-50}"
    ;;
  help|-h|--help|"") cmd_help ;;
  *)
    echo "$(autodeploy_msg 'Unknown command: %s' "$1")" >&2
    cmd_help
    exit 1
    ;;
esac
