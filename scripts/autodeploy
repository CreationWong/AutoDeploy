set -euo pipefail

DATA_DIR="${AUTODEPLOY_DATA_DIR:-/data}"
ENV_FILE="/etc/autodeploy/env"
SETTINGS_FILE="$DATA_DIR/settings.env"
GIT_HOME="$DATA_DIR/git-home"

log() { printf '[AutoDeploy] %s\n' "$*"; }
# shellcheck source=scripts/autodeploy-endpoints
. /usr/local/bin/autodeploy-endpoints

load_settings() {
  if [ -r "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
  fi
  if [ -r "$SETTINGS_FILE" ]; then
    set -a
    . "$SETTINGS_FILE"
    set +a
  fi
  REPO_NAME="${REPO_NAME:-app}"
  DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"
  DEPLOY_TAG="${DEPLOY_TAG:-}"
  DEPLOY_TAG_MODE="${DEPLOY_TAG_MODE:-commit}"
  AUTODEPLOY_CONFIG_NAME="${AUTODEPLOY_CONFIG_NAME:-AutoDeploy.config.yaml}"
}

write_env_file() {
  local tmp
  tmp="$(mktemp)"
  {
    printf 'REPO_NAME=%q\n' "$REPO_NAME"
    printf 'DEPLOY_BRANCH=%q\n' "$DEPLOY_BRANCH"
    printf 'DEPLOY_TAG=%q\n' "$DEPLOY_TAG"
    printf 'DEPLOY_TAG_MODE=%q\n' "$DEPLOY_TAG_MODE"
    printf 'AUTODEPLOY_CONFIG_NAME=%q\n' "$AUTODEPLOY_CONFIG_NAME"
  } > "$tmp"
  chown root:git "$tmp" 2>/dev/null || true
  chmod 640 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

cmd_show() {
  load_settings
  echo "AutoDeploy 设置"
  printf '  REPO_NAME              = %s\n' "$REPO_NAME"
  printf '  DEPLOY_BRANCH          = %s\n' "$DEPLOY_BRANCH"
  printf '  DEPLOY_TAG             = %s\n' "${DEPLOY_TAG:-<未启用>}"
  printf '  DEPLOY_TAG_MODE        = %s\n' "$DEPLOY_TAG_MODE"
  printf '  AUTODEPLOY_CONFIG_NAME = %s\n' "$AUTODEPLOY_CONFIG_NAME"
  printf '  HTTP_USER              = %s\n' "$(autodeploy_http_user)"
  autodeploy_log_endpoints
  echo

  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  echo "裸仓库: $repo_dir"
  if [ -d "$repo_dir" ] && git --git-dir="$repo_dir" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    git --git-dir="$repo_dir" log -1 --date=short \
      --format='  最近提交: %h %s (%an, %ad)'
  else
    echo "  (暂无提交)"
  fi
  echo

  echo "部署状态:"
  local f found=0 n t s c b u fc d
  for f in "$DATA_DIR"/state/*/deploy.json; do
    [ -f "$f" ] || continue
    found=1
    n="$(yq -r '.name // ""' "$f")"
    t="$(yq -r '.type // ""' "$f")"
    s="$(yq -r '.status // ""' "$f")"
    c="$(yq -r '.commit // ""' "$f")"
    b="$(yq -r '.branch // ""' "$f")"
    u="$(yq -r '.updated_at // ""' "$f")"
    fc="$(yq -r '.failed_commit // ""' "$f")"
    printf '  %s (type=%s) status=%s branch=%s commit=%.12s at %s\n' "$n" "$t" "$s" "$b" "$c" "$u"
    [ -n "$fc" ] && printf '    失败提交: %.12s\n' "$fc"
    d="$DATA_DIR/state/$n/failed.json"
    if [ -f "$d" ]; then
      printf '    已标记失败: %.12s (%s, rescued=%s) %s\n' \
        "$(yq -r '.commit // ""' "$d")" "$(yq -r '.branch // ""' "$d")" \
        "$(yq -r '.rescued // false' "$d")" "$(yq -r '.message // ""' "$d")"
    fi
  done
  [ "$found" = "1" ] || echo "  (无部署记录)"
}

cmd_log() {
  load_settings
  local n="${1:-10}"
  case "$n" in ''|*[!0-9]*) n=10 ;; esac
  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  if [ ! -d "$repo_dir" ]; then
    echo "裸仓库不存在: $repo_dir" >&2
    return 1
  fi
  if ! git --git-dir="$repo_dir" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    echo "(暂无提交记录)"
    return 0
  fi
  git --git-dir="$repo_dir" log -n "$n" --all --decorate --date=short \
    --format='%h  %ad  %an  %d %s'
}

cmd_set() {
  load_settings
  local key="$1" value="$2" tmp
  key="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
  case "$key" in
    CONFIG_NAME|AUTODEPLOY_CONFIG_NAME) key=AUTODEPLOY_CONFIG_NAME ;;
    REPO_NAME|DEPLOY_BRANCH|DEPLOY_TAG|DEPLOY_TAG_MODE) ;;
    *)
      echo "不支持修改的键: $1（可选: REPO_NAME, DEPLOY_BRANCH, DEPLOY_TAG, DEPLOY_TAG_MODE, AUTODEPLOY_CONFIG_NAME）" >&2
      return 1
      ;;
  esac
  if [ -z "$value" ] && [ "$key" != "DEPLOY_TAG" ]; then
    echo "值不能为空" >&2
    return 1
  fi

  case "$key" in
    REPO_NAME)
      if ! [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
        echo "REPO_NAME 非法（仅字母数字下划线点和连字符）: $value" >&2
        return 1
      fi
      ;;
    AUTODEPLOY_CONFIG_NAME)
      case "$value" in */*) echo "配置名不能包含 /: $value" >&2; return 1 ;; esac
      ;;
    DEPLOY_TAG_MODE)
      case "$value" in commit|branch) ;; *) echo "DEPLOY_TAG_MODE 只能是 commit 或 branch: $value" >&2; return 1 ;; esac
      ;;
  esac

  tmp="$(mktemp)"
  if [ -f "$SETTINGS_FILE" ]; then
    grep -v "^${key}=" "$SETTINGS_FILE" > "$tmp" || true
  fi
  printf '%s=%q\n' "$key" "$value" >> "$tmp"
  chown root:git "$tmp"
  chmod 640 "$tmp"
  mv "$tmp" "$SETTINGS_FILE"

  case "$key" in
    REPO_NAME) REPO_NAME="$value" ;;
    DEPLOY_BRANCH) DEPLOY_BRANCH="$value" ;;
    DEPLOY_TAG) DEPLOY_TAG="$value" ;;
    DEPLOY_TAG_MODE) DEPLOY_TAG_MODE="$value" ;;
    AUTODEPLOY_CONFIG_NAME) AUTODEPLOY_CONFIG_NAME="$value" ;;
  esac
  write_env_file
  log "已更新 $key=$value（下一次推送生效，重启后保留）"
}

cmd_deploy() {
  load_settings
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo "用法: autodeploy deploy <branch|tag|commit>" >&2
    return 1
  fi
  local repo_dir="$GIT_HOME/${REPO_NAME}.git"
  if [ ! -d "$repo_dir" ]; then
    echo "裸仓库不存在: $repo_dir" >&2
    return 1
  fi
  GIT_DIR="$repo_dir" /usr/local/bin/autodeploy-post-receive --ref "$ref"
}

cmd_logs() {
  load_settings
  local name="${1:-}" n="${2:-50}" f
  case "$n" in ''|*[!0-9]*) n=50 ;; esac
  if [ -z "$name" ]; then
    for f in "$DATA_DIR"/state/*/deploy.json; do
      [ -f "$f" ] || continue
      name="$(yq -r '.name // ""' "$f" 2>/dev/null || true)"
      [ -n "$name" ] && break
    done
  fi
  if [ -z "$name" ]; then
    echo "未找到应用，用法: autodeploy logs <name> [N]" >&2
    return 1
  fi
  local dir="$DATA_DIR/logs/$name"
  if [ ! -d "$dir" ]; then
    echo "日志目录不存在: $dir" >&2
    return 1
  fi
  for f in "$dir"/*.log; do
    [ -f "$f" ] || continue
    echo "==> $f (最近 $n 行) <=="
    tail -n "$n" "$f"
  done
}

cmd_retry() {
  load_settings
  local commit="" f
  for f in "$DATA_DIR"/state/*/last-success.json "$DATA_DIR"/state/*/deploy.json; do
    [ -f "$f" ] || continue
    if [ "$(yq -r '.status // ""' "$f" 2>/dev/null || true)" = "success" ]; then
      commit="$(yq -r '.commit // ""' "$f" 2>/dev/null || true)"
      [ -n "$commit" ] && break
    fi
  done
  if [ -z "$commit" ]; then
    echo "没有可重试的成功提交" >&2
    return 1
  fi
  echo "重新部署上次成功提交: ${commit:0:12}"
  cmd_deploy "$commit"
}

cmd_help() {
  cat <<'EOF'
AutoDeploy 管理命令

用法: autodeploy <命令> [参数]

  show                      查看当前设置、裸仓库最近提交与部署状态
  set <KEY> <VALUE>         修改设置（写入 /data/settings.env，重启后保留）
  deploy <branch|tag|commit> 手动部署指定 ref（可用于回滚）
  retry                     重新部署上次成功提交
  logs [name] [N]           查看应用日志（默认第一个应用，最近 50 行）
  log [N]                   查看当前项目提交历史（默认最近 10 条）
  license                   查看 GNU GPL 第 3 版许可全文
  help                      显示本帮助

可修改的 KEY:
  REPO_NAME                 裸仓库/默认应用名（默认 app）
  DEPLOY_BRANCH             默认触发部署的分支，逗号分隔、支持 * 通配（默认 main）
  DEPLOY_TAG                默认触发部署的标签，逗号分隔、支持 * 通配（默认空=不启用）
  DEPLOY_TAG_MODE           标签命中后的行为：commit=部署标签提交 / branch=部署标签所在分支最新提交（默认 commit）
  AUTODEPLOY_CONFIG_NAME    部署配置文件名（默认 AutoDeploy.config.yaml）

说明: 上述触发规则可在项目 AutoDeploy.config.yaml 的 deploy 段按项目覆盖；
      修改对下一次 git push 生效；REPO_NAME 不会重命名已存在的裸仓库。

Copyright (C) 2026 CreationWong
许可: GNU GPL 第 3 版 (GPL-3.0-only)。本程序不提供任何担保。
可按许可条款修改和再分发；运行 autodeploy license 查看全文。
EOF
}

case "${1:-help}" in
  show|status) cmd_show ;;
  license|--license) cat /usr/share/doc/autodeploy/LICENSE ;;
  log|history)
    shift
    cmd_log "${1:-10}"
    ;;
  set)
    shift
    if [ "$#" -lt 2 ]; then
      echo "用法: autodeploy set <KEY> <VALUE>" >&2
      exit 1
    fi
    cmd_set "$1" "$2"
    ;;
  deploy)
    shift
    cmd_deploy "${1:-}"
    ;;
  retry|redeploy) cmd_retry ;;
  logs)
    shift
    cmd_logs "${1:-}" "${2:-50}"
    ;;
  help|-h|--help|"") cmd_help ;;
  *)
    echo "未知命令: $1" >&2
    cmd_help
    exit 1
    ;;
esac
